<?xml version="1.0" encoding="utf-8"?>
<!-- Password for a Wi-Fi network picked in the menu's Wi-Fi panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:elevation="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="-0.01" />

    <EditText
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/settings_choice_bg"
        android:hint="@string/wifi_password"
        android:textColorHint="#80FFFFFF"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:fontFamily="@font/outfit"
        android:inputType="textPassword"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:singleLine="true"
        android:importantForAutofill="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnShowPassword"
            style="@style/TopButton"
            android:text="@string/wifi_show_password" />

        <TextView
            android:id="@+id/btnJoin"
            style="@style/TopButton"
            android:text="@string/wifi_join" />
    </LinearLayout>
</LinearLayout>
