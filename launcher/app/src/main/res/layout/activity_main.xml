<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.dante.tv.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="124dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="@font/outfit_light"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="112dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <!-- Clock block, top right like tvOS. The texts use gravity right, not end: the launcher lays out
             left to right (no supportsRtl). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:gravity="right"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#8CFFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.22"
                android:textAllCaps="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="40sp"
                    android:fontFamily="@font/outfit_light"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false" />

                <TextClock
                    android:id="@+id/ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="6dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />
            </LinearLayout>

            <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
            <TextView
                android:id="@+id/shamsiDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_regular"
                android:letterSpacing="0.02"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#A6FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_regular"
                android:letterSpacing="0.14"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- Dims the apps while the menu is open. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Left menu: an icon rail that slides open into a frosted panel with labels when it has focus. -->
    <FrameLayout
        android:id="@+id/sidebar"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:clipChildren="false">

        <View
            android:id="@+id/sidebarBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/sidebar_bg"
            android:alpha="0"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="22dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/navHome"
                style="@style/SidebarItem">

                <ImageView
                    style="@style/SidebarIcon"
                    android:src="@drawable/ic_home" />

                <TextView
                    style="@style/SidebarLabel"
                    android:text="@string/nav_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navApps"
                style="@style/SidebarItem">

                <ImageView
                    style="@style/SidebarIcon"
                    android:src="@drawable/ic_apps" />

                <TextView
                    style="@style/SidebarLabel"
                    android:text="@string/nav_apps" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navInputs"
                style="@style/SidebarItem">

                <ImageView
                    style="@style/SidebarIcon"
                    android:src="@drawable/ic_input" />

                <TextView
                    style="@style/SidebarLabel"
                    android:text="@string/inputs" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navWifi"
                style="@style/SidebarItem">

                <ImageView
                    android:id="@+id/wifiIcon"
                    style="@style/SidebarIcon"
                    android:src="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/wifiLabel"
                    style="@style/SidebarLabel"
                    android:maxWidth="170dp"
                    android:ellipsize="end"
                    android:text="@string/wifi" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navQuick"
                style="@style/SidebarItem">

                <ImageView
                    style="@style/SidebarIcon"
                    android:src="@drawable/ic_quick" />

                <TextView
                    style="@style/SidebarLabel"
                    android:text="@string/nav_quick" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navOptimize"
                style="@style/SidebarItem">

                <ImageView
                    android:id="@+id/optimizeIcon"
                    style="@style/SidebarIcon"
                    android:src="@drawable/ic_optimize" />

                <TextView
                    style="@style/SidebarLabel"
                    android:text="@string/nav_optimize" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                style="@style/SidebarItem">

                <ImageView
                    style="@style/SidebarIcon"
                    android:src="@drawable/ic_settings" />

                <TextView
                    style="@style/SidebarLabel"
                    android:text="@string/settings" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
