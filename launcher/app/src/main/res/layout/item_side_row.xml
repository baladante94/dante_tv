<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/sidebar_item_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/sideIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:duplicateParentState="true"
        android:tint="@drawable/pill_text"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/sideLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:singleLine="true"
        android:duplicateParentState="true"
        android:textColor="@drawable/pill_text"
        android:textSize="17sp"
        android:fontFamily="@font/outfit_medium" />

    <TextView
        android:id="@+id/sideStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="190dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:duplicateParentState="true"
        android:textColor="@drawable/pill_text_dim"
        android:textSize="13sp"
        android:fontFamily="@font/outfit" />
</LinearLayout>
