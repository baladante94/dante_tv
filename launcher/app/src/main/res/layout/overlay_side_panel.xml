<?xml version="1.0" encoding="utf-8"?>
<!-- The remote's Settings button: a panel from the right edge, over whatever is on screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/sideScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"
        android:alpha="0" />

    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@drawable/side_panel_bg"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="26dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:fontFamily="@font/outfit_light" />

        <TextView
            android:id="@+id/sideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="12dp"
            android:text="@string/side_title"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.2"
            android:textAllCaps="true"
            android:fontFamily="@font/outfit_medium" />

        <!-- Scrolls only if a TV's screen is too short for every row. The list clips to its own box so scrolled
             rows never draw over the clock and title; the padding inside it leaves room for the focus zoom. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-14dp"
            android:layout_marginEnd="-14dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipChildren="true"
            android:clipToPadding="true">

            <LinearLayout
                android:id="@+id/sideRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="16dp"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
