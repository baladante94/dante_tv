<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the screen while Optimize steps through Settings, so the pages it opens are never seen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF06080D">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/spinner"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_optimize"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/coverTitle"
            android:layout_marginTop="18dp"
            android:text="@string/optimize_title"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:fontFamily="@font/outfit_light" />

        <TextView
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#A6FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/outfit_regular" />
    </LinearLayout>
</FrameLayout>
